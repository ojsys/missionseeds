# ============================================================================
# assets/uploads — images ONLY
# Never execute scripts here. Hardened for Hostinger LiteSpeed / Apache.
# Uses SetEnvIf-based allowlist so the rule ordering is unambiguous and the
# "deny everything else" actually wins for non-images (no directive merge bugs).
# ============================================================================

# 1. Environment-flag ALLOWLIST — only real image extensions match this env var.
#    (?i) = case-insensitive so .JPG / .jpg / .Png all work.
SetEnvIfNoCase Request_URI "\.(png|jpe?g|gif|webp|avif|svg|ico|bmp)$" SAFE_UPLOAD_IMAGE

# 2. ACCESS CONTROL — one rule, one outcome.
#    If SAFE_UPLOAD_IMAGE is set → Allow.
#    Otherwise → Require all denied.
<RequireAll>
  Require env SAFE_UPLOAD_IMAGE
</RequireAll>

# Explicit deny for web shell extensions (belt+suspenders, even if case differs)
<FilesMatch "\.(?i:php\d?|phtml|phar|pht|pl|py|rb|cgi|sh|bash|zsh|ksh|jsp|jspx|asp|aspx|ashx|cfm|shtml|hta|htaccess|ini|conf|env|sql|md|htpasswd)$">
  Require all denied
</FilesMatch>

# 3. Never run the PHP engine here (works on Apache / LiteSpeed)
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<IfModule mod_php8.c>
  php_flag engine off
</IfModule>
# Hostinger sometimes uses LSPHP:
<IfModule litespeed>
  php_flag engine off
</IfModule>

# 4. Disable handlers entirely — even if mime-type set, nothing is executed
RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .pl .py .cgi
RemoveType .php .php3 .php4 .php5 .php7 .php8 .phtml
SetHandler default-handler

# 5. No directory browsing (defense in depth)
Options -Indexes -MultiViews -ExecCGI -FollowSymLinks
AllowOverride None

# 6. No source disclosure / server signature
ServerTokens Prod
FileETag None

# 7. Cache uploaded images aggressively
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png                              "access plus 1 year"
  ExpiresByType image/gif                              "access plus 1 year"
  ExpiresByType image/jpeg                             "access plus 1 year"
  ExpiresByType image/jpg                              "access plus 1 year"
  ExpiresByType image/webp                             "access plus 1 year"
  ExpiresByType image/avif                             "access plus 1 year"
  ExpiresByType image/svg+xml                          "access plus 1 year"
  ExpiresByType image/x-icon                           "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=31536000, immutable"
  Header set X-Content-Type-Options "nosniff"
  Header set Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'none'; script-src 'none'"
  Header unset X-Powered-By
</IfModule>
